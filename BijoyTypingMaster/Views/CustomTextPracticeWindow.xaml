<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BijoyTypingMaster.Views.CustomTextPracticeWindow"
             Title="Custom Practice 📝">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="20" RowSpacing="15">

        <!-- Stats Header -->
        <Border Grid.Row="0"
                BackgroundColor="#1e293b"
                Stroke="#334155"
                StrokeThickness="2"
                Padding="15"
                StrokeShape="RoundRectangle 10">
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                <VerticalStackLayout Grid.Column="0" Spacing="3">
                    <Label Text="⏱️ TIME"
                           FontSize="11"
                           TextColor="#94a3b8"
                           HorizontalOptions="Center"/>
                    <Label x:Name="TimerLabel"
                           Text="00:00"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1" Spacing="3">
                    <Label Text="🚀 WPM"
                           FontSize="11"
                           TextColor="#94a3b8"
                           HorizontalOptions="Center"/>
                    <Label x:Name="WPMLabel"
                           Text="0"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="#10b981"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="2" Spacing="3">
                    <Label Text="✓ ACCURACY"
                           FontSize="11"
                           TextColor="#94a3b8"
                           HorizontalOptions="Center"/>
                    <Label x:Name="AccuracyLabel"
                           Text="100%"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="#6366f1"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Grid>
        </Border>

        <!-- Title -->
        <Label Grid.Row="1"
               x:Name="TitleLabel"
               Text="Practice: Custom Text"
               FontSize="20"
               FontAttributes="Bold"
               TextColor="White"
               HorizontalOptions="Center"/>

        <!-- Practice Area -->
        <Border Grid.Row="2"
                BackgroundColor="#1e293b"
                Stroke="#334155"
                StrokeThickness="2"
                Padding="25"
                StrokeShape="RoundRectangle 12">
            <VerticalStackLayout Spacing="20" VerticalOptions="Center">
                <ScrollView HeightRequest="200">
                    <Label x:Name="TargetTextLabel"
                           FontSize="18"
                           TextColor="White"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"
                           LineBreakMode="WordWrap"/>
                </ScrollView>

                <Entry x:Name="UserInputEntry"
                       Placeholder="Start typing..."
                       FontSize="18"
                       TextColor="White"
                       PlaceholderColor="#94a3b8"
                       BackgroundColor="#0f172a"
                       HeightRequest="50"
                       IsEnabled="False"
                       TextChanged="OnTextChanged"/>

                <ProgressBar x:Name="ProgressBar"
                           Progress="0"
                           ProgressColor="#10b981"
                           HeightRequest="6"/>

                <Label x:Name="ProgressLabel"
                       Text="0% Complete"
                       FontSize="14"
                       TextColor="#94a3b8"
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>
        </Border>

        <!-- Controls -->
        <HorizontalStackLayout Grid.Row="3" Spacing="15" HorizontalOptions="Center">
            <Button x:Name="StartButton"
                    Text="▶️ START"
                    FontSize="18"
                    FontAttributes="Bold"
                    BackgroundColor="#10b981"
                    TextColor="White"
                    WidthRequest="150"
                    HeightRequest="50"
                    CornerRadius="10"
                    Clicked="OnStartClicked"/>

            <Button x:Name="ResetButton"
                    Text="🔄 RESET"
                    FontSize="18"
                    FontAttributes="Bold"
                    BackgroundColor="#6b7280"
                    TextColor="White"
                    WidthRequest="150"
                    HeightRequest="50"
                    CornerRadius="10"
                    Clicked="OnResetClicked"
                    IsEnabled="False"/>
        </HorizontalStackLayout>

    </Grid>

</ContentPage>
