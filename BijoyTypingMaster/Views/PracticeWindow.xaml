<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BijoyTypingMaster.Views.PracticeWindow"
             Title="Practice Typing">

    <Grid RowDefinitions="Auto,*,Auto,Auto" Padding="20">
        
        <!-- Header with stats -->
        <Grid Grid.Row="0" ColumnDefinitions="*,*,*,*" Margin="0,0,0,20">
            <StackLayout Grid.Column="0">
                <Label Text="WPM" FontSize="12" HorizontalOptions="Center"/>
                <Label x:Name="WpmLabel" Text="0.00" FontSize="24" FontAttributes="Bold" 
                       HorizontalOptions="Center" TextColor="{StaticResource Primary}"/>
            </StackLayout>
            
            <StackLayout Grid.Column="1">
                <Label Text="Accuracy" FontSize="12" HorizontalOptions="Center"/>
                <Label x:Name="AccuracyLabel" Text="100.00%" FontSize="24" FontAttributes="Bold" 
                       HorizontalOptions="Center" TextColor="{StaticResource Primary}"/>
            </StackLayout>
            
            <StackLayout Grid.Column="2">
                <Label Text="Progress" FontSize="12" HorizontalOptions="Center"/>
                <Label x:Name="ProgressLabel" Text="0%" FontSize="24" FontAttributes="Bold" 
                       HorizontalOptions="Center" TextColor="{StaticResource Primary}"/>
            </StackLayout>
            
            <StackLayout Grid.Column="3">
                <Label Text="Layout" FontSize="12" HorizontalOptions="Center"/>
                <Label x:Name="LayoutLabel" Text="Bijoy" FontSize="24" FontAttributes="Bold" 
                       HorizontalOptions="Center" TextColor="{StaticResource Primary}"/>
            </StackLayout>
        </Grid>

        <!-- Lesson Text Display with Color Coding -->
        <ScrollView Grid.Row="1">
            <StackLayout>
                <Label Text="Target Text:" FontSize="14" Margin="0,0,0,10"/>
                
                <!-- This will display the lesson text with color highlighting -->
                <Label x:Name="TargetTextLabel" 
                       FontSize="32" 
                       LineBreakMode="WordWrap"
                       Margin="0,0,0,20">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTextTapped"/>
                    </Label.GestureRecognizers>
                </Label>
                
                <BoxView HeightRequest="2" Color="{StaticResource Gray300}" Margin="0,10"/>
                
                <Label Text="Your Input:" FontSize="14" Margin="0,10,0,10"/>
                <Label x:Name="UserInputLabel" 
                       FontSize="32" 
                       LineBreakMode="WordWrap"
                       TextColor="{StaticResource Black}"/>
            </StackLayout>
        </ScrollView>

        <!-- Hidden Entry for capturing keyboard input -->
        <Entry x:Name="HiddenEntry" 
               Grid.Row="2"
               Opacity="0.01"
               HeightRequest="1"
               TextChanged="OnTextChanged"
               Focused="OnEntryFocused"
               Unfocused="OnEntryUnfocused"/>

        <!-- Control Buttons -->
        <Grid Grid.Row="3" ColumnDefinitions="*,*,*" ColumnSpacing="10" Margin="0,20,0,0">
            <Button Grid.Column="0" 
                    x:Name="StartButton" 
                    Text="Start" 
                    Clicked="OnStartClicked"/>
            
            <Button Grid.Column="1" 
                    x:Name="ResetButton" 
                    Text="Reset" 
                    Clicked="OnResetClicked"
                    IsEnabled="False"/>
            
            <Button Grid.Column="2" 
                    x:Name="FinishButton" 
                    Text="Finish &amp; Save" 
                    Clicked="OnFinishClicked"
                    IsEnabled="False"/>
        </Grid>

    </Grid>

</ContentPage>
