<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:BijoyTypingMaster"
             x:Class="BijoyTypingMaster.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Custom Colors -->
            <Color x:Key="CorrectColor">#4CAF50</Color>
            <Color x:Key="WrongColor">#F44336</Color>
            <Color x:Key="CurrentColor">#FFC107</Color>
            <Color x:Key="PendingColor">#9E9E9E</Color>

            <!-- Fonts -->
            <OnPlatform x:Key="BijoyFont" x:TypeArguments="x:String">
                <On Platform="WinUI" Value="SutonnyMJ" />
            </OnPlatform>

        </ResourceDictionary>
    </Application.Resources>
</Application>
