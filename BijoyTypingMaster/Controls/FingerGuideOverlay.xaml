<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BijoyTypingMaster.Controls.FingerGuideOverlay">
    
    <Border Background="#BB000000"
            Padding="15"
            VerticalOptions="Start"
            HorizontalOptions="Center"
            Margin="0,10,0,0">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="10"/>
        </Border.StrokeShape>
        
        <VerticalStackLayout Spacing="10">
            
            <!-- Title -->
            <Label Text="✋ Finger Position Guide" 
                   FontSize="16" 
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="White"/>
            
            <!-- Left Hand -->
            <Border StrokeThickness="1" 
                    Stroke="White"
                    Padding="10"
                    Background="#22FFFFFF">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="5"/>
                </Border.StrokeShape>
                
                <VerticalStackLayout Spacing="8">
                    <Label Text="Left Hand" 
                           FontSize="12" 
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           TextColor="White"/>
                    
                    <Grid ColumnDefinitions="*,*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="5" RowSpacing="3">
                        <!-- Pinky -->
                        <Border Grid.Row="0" Grid.Column="0" Background="Red" Padding="5" StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="3"/>
                            </Border.StrokeShape>
                            <Label Text="Pinky" FontSize="10" HorizontalOptions="Center" TextColor="White"/>
                        </Border>
                        <Label Grid.Row="1" Grid.Column="0" Text="a, q, z, 1" FontSize="8" HorizontalOptions="Center" TextColor="White"/>
                        
                        <!-- Ring -->
                        <Border Grid.Row="0" Grid.Column="1" Background="Orange" Padding="5" StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="3"/>
                            </Border.StrokeShape>
                            <Label Text="Ring" FontSize="10" HorizontalOptions="Center" TextColor="White"/>
                        </Border>
                        <Label Grid.Row="1" Grid.Column="1" Text="s, w, x, 2" FontSize="8" HorizontalOptions="Center" TextColor="White"/>
                        
                        <!-- Middle -->
                        <Border Grid.Row="0" Grid.Column="2" Background="Yellow" Padding="5" StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="3"/>
                            </Border.StrokeShape>
                            <Label Text="Middle" FontSize="10" HorizontalOptions="Center" TextColor="Black"/>
                        </Border>
                        <Label Grid.Row="1" Grid.Column="2" Text="d, e, c, 3" FontSize="8" HorizontalOptions="Center" TextColor="White"/>
                        
                        <!-- Index -->
                        <Border Grid.Row="0" Grid.Column="3" Background="Green" Padding="5" StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="3"/>
                            </Border.StrokeShape>
                            <Label Text="Index" FontSize="10" HorizontalOptions="Center" TextColor="White"/>
                        </Border>
                        <Label Grid.Row="1" Grid.Column="3" Text="f, g, r, t, v, b" FontSize="7" HorizontalOptions="Center" TextColor="White"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>
            
            <!-- Right Hand -->
            <Border StrokeThickness="1" 
                    Stroke="White"
                    Padding="10"
                    Background="#22FFFFFF">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="5"/>
                </Border.StrokeShape>
                
                <VerticalStackLayout Spacing="8">
                    <Label Text="Right Hand" 
                           FontSize="12" 
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           TextColor="White"/>
                    
                    <Grid ColumnDefinitions="*,*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="5" RowSpacing="3">
                        <!-- Index -->
                        <Border Grid.Row="0" Grid.Column="0" Background="Blue" Padding="5" StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="3"/>
                            </Border.StrokeShape>
                            <Label Text="Index" FontSize="10" HorizontalOptions="Center" TextColor="White"/>
                        </Border>
                        <Label Grid.Row="1" Grid.Column="0" Text="j, h, y, u, n, m" FontSize="7" HorizontalOptions="Center" TextColor="White"/>
                        
                        <!-- Middle -->
                        <Border Grid.Row="0" Grid.Column="1" Background="Indigo" Padding="5" StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="3"/>
                            </Border.StrokeShape>
                            <Label Text="Middle" FontSize="10" HorizontalOptions="Center" TextColor="White"/>
                        </Border>
                        <Label Grid.Row="1" Grid.Column="1" Text="k, i, 8, ," FontSize="8" HorizontalOptions="Center" TextColor="White"/>
                        
                        <!-- Ring -->
                        <Border Grid.Row="0" Grid.Column="2" Background="Purple" Padding="5" StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="3"/>
                            </Border.StrokeShape>
                            <Label Text="Ring" FontSize="10" HorizontalOptions="Center" TextColor="White"/>
                        </Border>
                        <Label Grid.Row="1" Grid.Column="2" Text="l, o, 9, ." FontSize="8" HorizontalOptions="Center" TextColor="White"/>
                        
                        <!-- Pinky -->
                        <Border Grid.Row="0" Grid.Column="3" Background="Pink" Padding="5" StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="3"/>
                            </Border.StrokeShape>
                            <Label Text="Pinky" FontSize="10" HorizontalOptions="Center" TextColor="Black"/>
                        </Border>
                        <Label Grid.Row="1" Grid.Column="3" Text=";, p, 0, -, =" FontSize="7" HorizontalOptions="Center" TextColor="White"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>
            
            <!-- Current Key Highlight -->
            <Border x:Name="CurrentKeyBorder"
                    StrokeThickness="2" 
                    Stroke="Yellow"
                    Background="#66FFFF00"
                    Padding="10"
                    IsVisible="False">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="5"/>
                </Border.StrokeShape>
                <Label x:Name="CurrentKeyLabel" 
                       Text="" 
                       FontSize="14" 
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       TextColor="White"/>
            </Border>
            
        </VerticalStackLayout>
    </Border>
    
</ContentView>
